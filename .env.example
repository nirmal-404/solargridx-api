# Copy this file to .env and replace values for your local machine.
# .env is ignored by Git and must never be committed.

ASPNETCORE_ENVIRONMENT=Development
Jwt__Secret=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=SolarGridX.Api
Jwt__Audience=SolarGridX.Clients
Jwt__ExpirationMinutes=120
Jwt__RefreshTokenExpirationDays=7
OAuth__Google__ClientId=your-google-client-id.apps.googleusercontent.com
OAuth__Google__ClientSecret=your-google-client-secret
OAuth__Google__AllowTestTokens=true
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=SolarGridX
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
